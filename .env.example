# Sao chép file này thành .env.local rồi điền giá trị thật.
# Mọi biến VITE_ đều nằm trong code gửi xuống trình duyệt → ai cũng xem được.
# Vì vậy CHỈ để khoá "publishable" của Supabase ở đây, TUYỆT ĐỐI không để service_role key.

# ---------- Supabase (lưu người đăng ký popup, RSVP, lời chúc, ảnh) ----------
# Project: thiep-moi-graduation-gala (Singapore)
VITE_SUPABASE_URL="https://jbnemrbfdxngqzlrsyve.supabase.co"
# Khoá publishable: an toàn để công khai vì database chỉ cho khách GHI qua 3 hàm,
# không cho ĐỌC bảng nào (xem supabase/schema.sql)
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_B30z5TW4UxH0WK9ayoymDA_bsMSmX1z"
VITE_SUPABASE_PHOTO_BUCKET="guest-photos"

# ---------- Thông tin sự kiện (hiện trên vé + thiệp) ----------
VITE_EVENT_NAME="Graduation Gala 2026"
# Giờ bắt đầu/kết thúc — dùng cho đồng hồ đếm ngược (ISO 8601, giờ Việt Nam)
VITE_EVENT_START="2026-10-16T13:00:00+07:00"
VITE_EVENT_DATE_LABEL="OCTOBER 16, 2026"
VITE_EVENT_TIME_LABEL="13:00 FRIDAY"
VITE_EVENT_HOST="CUNG HIỆP"
VITE_EVENT_CONTACT="0985......."
VITE_EVENT_VENUE="HANOI UNIVERSITY OF BUSINESS AND TECHNOLOGY (HUBT)"
VITE_EVENT_ADDRESS="29A NGÕ 124 PHỐ VĨNH TUY, VĨNH HƯNG, HÀ NỘI"
VITE_EVENT_VENUE_VI="Trường Đại học Kinh doanh và Công nghệ Hà Nội (HUBT)"
VITE_EVENT_ADDRESS_VI="29A Ngõ 124 Phố Vĩnh Tuy, Vĩnh Hưng, Hà Nội"
VITE_EVENT_GREETER="Cung Hiệp"
VITE_EVENT_LAT="20.999974559250088"
VITE_EVENT_LNG="105.87773555465114"
VITE_EVENT_HALL="Hội trường nhà B"
VITE_EVENT_MAPS_URL="https://maps.app.goo.gl/bu5kia9D3XVXXy6W6"

# ---------- Chất lượng 3D ----------
# auto | high | low
VITE_QUALITY="auto"
# Giới hạn độ phân giải canvas trên điện thoại (mượt hơn, đỡ nóng máy)
VITE_MAX_DPR="2"
